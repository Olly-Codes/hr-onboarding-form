<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Onboarding dashboard</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <%- include("partials/nav") %>

  <div class="kpis">
    <div class="kpi kpi-open">
      <span class="kpi-icon">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      </span>
      <div>
        <span class="kpi-value"><%= stats.open %></span>
        <span class="kpi-label">Open onboardings</span>
      </div>
    </div>

    <div class="kpi kpi-pending">
      <span class="kpi-icon">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      </span>
      <div>
        <span class="kpi-value"><%= stats.pending %></span>
        <span class="kpi-label">Pending approvals</span>
      </div>
    </div>

    <div class="kpi kpi-soon">
      <span class="kpi-icon">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
      </span>
      <div>
        <span class="kpi-value"><%= stats.startingSoon %></span>
        <span class="kpi-label">Starting in 2 weeks</span>
      </div>
    </div>

    <div class="kpi kpi-overdue <%= stats.overdue ? '' : 'is-zero' %>">
      <span class="kpi-icon">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><line x1="12" x2="12" y1="9" y2="13"/><line x1="12" x2="12.01" y1="17" y2="17"/></svg>
      </span>
      <div>
        <span class="kpi-value"><%= stats.overdue %></span>
        <span class="kpi-label">Overdue</span>
      </div>
    </div>

    <div class="kpi kpi-done">
      <span class="kpi-icon">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
      </span>
      <div>
        <span class="kpi-value"><%= stats.onboarded %></span>
        <span class="kpi-label">Onboarded</span>
      </div>
    </div>
  </div>

  <div class="section-head">
    <h2>All new hires</h2>
    <span><%= hires.length %> total</span>
  </div>

  <% if (!hires.length) { %>
    <p>No new hires yet.</p>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Job</th>
            <th>Department</th>
            <th>Start date</th>
            <th>Stage</th>
            <th>Approval</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% hires.forEach((hire) => {
               const initials = hire.new_hire_name.trim().split(/\s+/).map((w) => w[0]).slice(0, 2).join("").toUpperCase();
          %>
            <tr>
              <td data-label="Name">
                <div class="person">
                  <span class="avatar" aria-hidden="true"><%= initials %></span>
                  <span><%= hire.new_hire_name %></span>
                </div>
              </td>
              <td data-label="Job"><%= hire.job.job_name %></td>
              <td data-label="Department"><%= hire.job.departments.department_name %></td>
              <td data-label="Start date">
                <span class="<%= hire.isOverdue ? 'date-overdue' : '' %>"><%= hire.new_hire_start_date %></span>
              </td>
              <td data-label="Stage">
                <div class="stage">
                  <span class="badge"><%= hire.new_hire_stage %></span>
                  <div class="progress" aria-hidden="true"><span style="width: <%= hire.progress %>%"></span></div> 
                </div>
              </td>
              <td data-label="Approval"><span class="badge badge-<%= hire.approval_status.toLowerCase() %>"><%= hire.approval_status %></span></td>
              <td class="actions">
                <a href="/hires/<%= hire.new_hire_id %>">View</a>
                <% if (hire.approval_status === "Pending") { %>
                  <a class="primary" href="/approve/<%= hire.new_hire_id %>">Review request</a>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</body>
</html>
